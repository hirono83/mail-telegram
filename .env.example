# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env는 git에 커밋되지 않습니다.
#
# 주의: 이 파일은 run_daily_agent.sh가 `source .env`로 그대로 읽습니다 (bash 문법).
# 값에 공백이 있으면 반드시 큰따옴표로 감싸세요. 예: OBSIDIAN_DAILY_FOLDER="Telegram Daily"
# (따옴표 없이 공백이 들어가면 "command not found" 에러가 납니다.)

# --- Telegram (https://my.telegram.org/apps 에서 발급) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# 최초 로그인(scripts/telegram/login.py) 시 사용할 전화번호. 이후 실행에는 불필요.
TELEGRAM_PHONE=
# 최근 N시간 이내 메시지만 수집 (체크포인트가 있으면 체크포인트 이후만 수집)
TELEGRAM_LOOKBACK_HOURS=24
# 채팅방 하나당 최대 수집 메시지 수
TELEGRAM_MAX_PER_CHAT=200

# --- Mail.app ---
# 안 읽은 메일 전부를 대상으로 합니다 (날짜 제한 없음). 아래는 한 번에 처리할 안전 상한값입니다.
MAIL_MAX_MESSAGES=500

# --- Obsidian (obsidian-local-rest-api 플러그인) ---
# Obsidian 앱 실행 중이어야 하며, 플러그인 설정에서 API 키를 발급받아야 합니다.
OBSIDIAN_API_URL=https://127.0.0.1:27124
OBSIDIAN_API_KEY=
# Obsidian 설정 > Core plugins > Daily notes 의 "새 파일 위치" / "날짜 형식"과 동일하게 맞추세요.
# 날짜 형식은 Python strftime 문법 (예: Obsidian의 YYYY-MM-DD = %Y-%m-%d)
OBSIDIAN_DAILY_FOLDER="Daily"
OBSIDIAN_DAILY_DATE_FORMAT=%Y-%m-%d
