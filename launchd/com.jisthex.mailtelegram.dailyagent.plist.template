<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jisthex.mailtelegram.dailyagent</string>

    <!-- REPO_PATH를 이 저장소를 clone/다운로드한 실제 절대 경로로 바꾸세요. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>REPO_PATH/scripts/run_daily_agent.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <!-- claude, python3, osascript 등을 PATH에서 찾을 수 있도록 최소한의 PATH를 지정합니다.
         본인 환경에 맞게 (예: pyenv, nvm, homebrew 경로 등) 조정하세요. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>REPO_PATH/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>REPO_PATH/logs/launchd.err.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
